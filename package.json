{
  "name": "planet-forge",
  "version": "0.25.2",
  "private": true,
  "description": "Planet Forge — przeglądarkowa strategia sci-fi z jedną planetą 3D (iPad / Safari).",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
